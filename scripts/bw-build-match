#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix_bin="$(command -v nix || true)"
if [[ -z "$nix_bin" ]]; then nix_bin=/nix/var/nix/profiles/default/bin/nix; fi
exec "$nix_bin" --extra-experimental-features 'nix-command flakes' develop "$root/nix" -c bash -c '
  set -euo pipefail
  cmake -S "$1/match-runner" -B "$1/build/match-runner" -G Ninja -DCMAKE_BUILD_TYPE=Release -DBW_ENV_ROOT="$1"
  cmake --build "$1/build/match-runner" --parallel "${BW_BUILD_JOBS:-4}"
' bash "$root"
