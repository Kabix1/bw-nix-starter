#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cmake -S "$root/StardustDevEnvironment" -B "$root/build" -G Ninja \
  -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
  -DOPENBW_ENABLE_UI=ON "$@"
cmake --build "$root/build" --target tests --parallel "${BW_BUILD_JOBS:-4}"
