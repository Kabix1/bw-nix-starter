#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for file in STARDAT.MPQ BROODAT.MPQ patch_rt.mpq; do
  if [[ ! -f "$root/data/$file" ]]; then
    echo "Missing data/$file. See README.md for game-data setup." >&2
    exit 1
  fi
done
bw-build
bw-test --gtest_list_tests
bw-test --gtest_filter=Steamhammer.RunOne
python3 - "$root" <<'PY'
import ctypes
import sys
from pathlib import Path
root = Path(sys.argv[1])
module = root / 'build/src/libDemoAIModule.so'
lib = ctypes.CDLL(str(module))
for symbol in ('gameInit', 'newAIModule'):
    getattr(lib, symbol)
print('PASS: headless game completed and Linux module entry points loaded.')
print('Your module:', module)
print('Replays:', root / 'build/test/replays')
PY
